# Esper API Configuration
# Copy this file to .env and fill in your actual credentials.
#
# The Esper API key itself is NOT a frontend env var — it is stored as a
# Worker Secret in the `worker-esper` Cloudflare Worker. The frontend only
# needs to know where the worker lives.

VITE_ESPER_BASE=https://worker-esper.support-1e5.workers.dev
VITE_ESPER_ENTERPRISE_ID=your_enterprise_id_here
